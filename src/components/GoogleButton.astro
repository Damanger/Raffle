---
interface Props { label?: string; secondary?: boolean }
const { label = 'Continuar con Google', secondary = false } = Astro.props;
---
<button class:list={['btn', secondary ? 'btn-outline' : 'btn-primary', 'google-login']} type="button">
  <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.5-.2-2.2H12v4.3h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.8 3-4.4 3-7.6ZM12 22c2.7 0 5-1 6.6-2.4l-3.2-2.5c-.9.6-2 .9-3.4.9-2.6 0-4.8-1.7-5.6-4H3.1v2.6A10 10 0 0 0 12 22ZM6.4 14a6 6 0 0 1 0-4V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14ZM12 6c1.4 0 2.7.5 3.7 1.5l2.8-2.8A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.9 5.4L6.4 10c.8-2.3 3-4 5.6-4Z"/></svg>
  <span data-google-label data-anonymous-label={label}>{label}</span>
</button>
