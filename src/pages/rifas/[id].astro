---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Wheel from '../../components/Wheel.astro';
import DeleteRaffleDialog from '../../components/DeleteRaffleDialog.astro';
import RaffleSettingsDialog from '../../components/RaffleSettingsDialog.astro';
import RaffleTeam from '../../components/RaffleTeam.astro';
import PrizeGallery from '../../components/PrizeGallery.astro';
import { winnerNumbers, recentWinners } from '../../lib/draw';
import { db } from '../../lib/server';
import type { RafflePublic } from '../../lib/model';
const id = Astro.params.id!;
const user = Astro.locals.user;
let raffle: RafflePublic | null = null;
let unavailable = false;
if (/^[\w-]{1,80}$/.test(id)) {
  try { raffle = (await db(`raffles/${id}/public`)).data; } catch { unavailable = true; }
}
if (!raffle) Astro.response.status = unavailable ? 503 : 404;
const isOwner = Boolean(user && raffle?.ownerId === user.uid);
let isAdmin = isOwner;
if (!isOwner && user?.emailVerified && user.email && raffle && Astro.locals.token) {
  try { isAdmin = Boolean((await db(`raffleAdmins/${id}/${user.email.toLowerCase().replace(/\./g,',')}`, Astro.locals.token)).data); } catch { /* A visitor can still see the public raffle. */ }
}
const soldCount = Object.keys(raffle?.sold || {}).length;
const firstTickets = raffle ? Array.from({length: Math.min(96,raffle.ticketCount)}, (_,i) => i + 1) : [];
---
<Layout title={`${raffle?.title || 'Rifa no disponible'} · rifas-squirrel`} user={user}>
  {raffle ? <main id="main-content" class="raffle-page shell" data-raffle-id={id} data-owner={isOwner ? 'true' : 'false'} data-admin={isAdmin ? 'true' : 'false'}>
    <div class="breadcrumb"><a href="/">Inicio</a><span>/</span>{isAdmin && <><a href="/perfil">Mi perfil</a><span>/</span></>}<span>Rifa</span></div>
    <figure id="raffle-cover" class="raffle-cover" hidden={!raffle.cover}><img id="raffle-cover-image" src={raffle.cover} alt={`Portada de ${raffle.title}`} fetchpriority="high"/></figure>
    <div class="raffle-title-row" data-reveal><div><span id="raffle-status" class:list={['status-pill', raffle.result && 'closed']}>{raffle.result ? 'Rifa finalizada' : raffle.draw ? 'Sorteo en curso' : 'Rifa activa'}</span><h1>{raffle.title}</h1><p>Organizada por {raffle.organizer}</p>{isAdmin && <span class="owner-label"><Icon name="lock" size={13}/>Estás administrando tu rifa</span>}</div><div class="raffle-actions"><button id="share-raffle" class="btn btn-outline"><Icon name="link" size={16}/>Compartir rifa</button>{isAdmin && <><button id="settings-button" class="btn btn-outline" type="button" disabled={!!raffle.draw || !!raffle.result}>Editar rifa</button>{isOwner && <button id="delete-raffle" type="button" class="btn btn-danger-outline">Eliminar rifa</button>}</>}</div></div>
    <div class="raffle-summary" data-reveal><span><strong>{raffle.ticketCount}</strong> boletos</span><span><strong id="sold-count">{soldCount}</strong> vendidos</span><span><strong id="available-count">{raffle.ticketCount - soldCount}</strong> disponibles</span><div class="progress-bar" role="progressbar" aria-label="Boletos vendidos" aria-valuemin="0" aria-valuemax={raffle.ticketCount} aria-valuenow={soldCount}><span id="sold-progress" style={`transform:scaleX(${soldCount/raffle.ticketCount})`}></span></div></div>
    <nav class="raffle-jump" aria-label="Secciones de la rifa"><a href="#wheel-panel">El sorteo</a><a href="#tickets-title">Los boletos</a><a href="#prizes-title">Los premios</a></nav>
    <div class="raffle-main">
      <div class="raffle-content">
        <section class="panel prize-panel" aria-labelledby="prizes-title" data-reveal><div class="panel-heading"><h2 id="prizes-title">Lo que puedes ganar</h2><small id="prize-count">{`${raffle.prizes.length} premio${raffle.prizes.length === 1 ? '' : 's'}`}</small></div>
          <PrizeGallery prizes={raffle.prizes}/>
        </section>
        <section class="panel ticket-panel" aria-labelledby="tickets-title" data-reveal><div class="panel-heading"><h2 id="tickets-title">Encuentra tu número</h2><small id="ticket-total">{raffle.ticketCount} oportunidades</small></div>
          <div class="ticket-controls"><label class="search-field"><Icon name="search" size={15}/><input id="ticket-search" class="input" type="search" inputmode="numeric" placeholder="Buscar número…" aria-label="Buscar número de boleto" maxlength="5"/></label><div class="filter-group" aria-label="Filtrar boletos"><button type="button" data-filter="all" aria-pressed="true">Todos</button><button type="button" data-filter="available" aria-pressed="false">Disponibles</button><button type="button" data-filter="sold" aria-pressed="false">Comprados</button><button type="button" data-filter="eliminated" aria-pressed="false">Eliminados</button><button type="button" data-filter="winners" aria-pressed="false">Ganadores</button></div></div>
          <div id="ticket-grid" class="ticket-grid">{firstTickets.map(n => <button class:list={['ticket', raffle.sold?.[n] && 'sold']} type="button" data-number={n} aria-label={`Boleto ${n}, ${raffle.sold?.[n] ? 'comprado' : 'disponible'}`}>{String(n).padStart(3,'0')}</button>)}</div>
          <p id="no-tickets" class="loading-state" hidden>No hay números que coincidan con tu búsqueda.</p>
          <div class="ticket-legend"><span><i class="legend-dot"></i>Disponible</span><span><i class="legend-dot sold"></i>Comprado</span><span><i class="legend-dot winner"></i>Ganador</span><span><i class="legend-dot eliminated"></i>Descartado</span></div>
          <div id="pagination" class="pagination"><button id="prev-page" type="button" disabled>← Anterior</button><span id="page-label" aria-live="polite">1–{firstTickets.length} de {raffle.ticketCount}</span><button id="next-page" type="button" disabled={raffle.ticketCount <= 96}>Siguiente →</button></div>
          <div id="ticket-detail" class="ticket-detail" role="status" aria-live="polite" hidden></div>
          <p class="field-help">{isAdmin ? 'Selecciona un boleto para registrar o corregir al comprador. Los datos y el historial solo son visibles para sus administradores.' : 'Selecciona un boleto disponible, escribe tu nombre y contacta al vendedor por WhatsApp para solicitarlo. El organizador confirmará la disponibilidad y registrará tu compra.'}</p>
        </section>
      </div>
      <aside id="wheel-panel" class="panel wheel-panel" aria-labelledby="wheel-title" data-reveal><div class="wheel-stage"><div class="wheel-visual"><div class="wheel-toolbar"><span class="wheel-live"><span class="live-dot"></span>El sorteo</span><button id="wheel-fullscreen" class="btn btn-outline" type="button" aria-controls="wheel-panel" aria-expanded="false">Pantalla completa</button></div><h2 id="wheel-title">El gran momento.</h2><p id="wheel-raffle-title" class="wheel-raffle-title">{raffle.title}</p><p id="wheel-caption">Una oportunidad por cada boleto comprado.</p>
        <div id="roulette-viewport" class="roulette-viewport" tabindex="0" aria-label="Ruleta completa. Usa el zoom y desplázate para consultar los números."><Wheel id="raffle-wheel"/></div>
        <label class="wheel-zoom">Zoom de la ruleta <input id="wheel-zoom" type="range" min="1" max="1" value="1" step="1"/><output id="wheel-zoom-value" for="wheel-zoom">1×</output></label>
        </div><div class="wheel-console"><div id="draw-awaiting" class="draw-awaiting" hidden={!!winnerNumbers(raffle).length}><Icon name="ticket" size={30}/><h3>Cada número.<br/>Una posibilidad.</h3><p>Los ganadores aparecerán aquí.<br/>El primer premio se anuncia al final.</p></div><p id="spin-status" class="spin-status" role="status"></p>
        <div id="spin-outcome" class="spin-outcome" role="status" hidden><span id="spin-outcome-label"></span><strong id="spin-outcome-number"></strong><span id="spin-outcome-buyer" class="result-buyer" hidden></span></div>
        <div id="winner-box" class="winner-box" hidden={!winnerNumbers(raffle).length}>
          <div class="winner-box-heading"><Icon name="gift" size={18}/><span id="winner-heading">Ganadores</span></div>
          <p class="winner-order-note">La cuenta va hacia el primer lugar.</p>
          <ol id="winner-list" class="winner-list">{recentWinners(raffle).map(({number,rank})=><li value={rank} data-rank={rank}><span class="winner-placement" aria-hidden="true">{rank}</span><div class="winner-person"><span class="result-buyer">{raffle.winnerNames?.[String(number)] || 'Nombre no registrado'}</span><span>Ganador {rank}{(raffle.draw?.winnerCount ?? 1) === raffle.prizes.length ? ` · ${raffle.prizes[rank-1]?.name || 'Premio'}` : (raffle.draw?.winnerCount ?? 1) === 1 ? ' · Todos los premios' : ''}</span></div><strong>#{String(number).padStart(3,'0')}</strong></li>)}</ol>
          <span id="winner-note"></span>
        </div>
        {isAdmin ? <><button id="draw-button" class="btn btn-primary" disabled={!!raffle.result || !soldCount}><Icon name="wheel" size={17}/>{raffle.result ? 'Resultado registrado' : 'Girar la ruleta'}</button><p class="field-help">Elige ganadores y descartes, giro a giro. Puedes hacer los descartes primero o intercalarlos con ganadores. Las ventas se cierran con el primer giro.</p></> : <p class="field-help">{raffle.result ? 'Los resultados del sorteo ya están registrados.' : 'El organizador hará los giros uno por uno. Aquí podrás consultar los descartes y todos los ganadores.'}</p>}
        <details class="wheel-participants"><summary>Todos los números participantes <span id="participant-count"></span></summary><div id="participants-list" class="participant-list" aria-label="Números que siguen participando"></div><p class="field-help">Cada número tiene un sector en la ruleta. Amplía con el zoom para leerlos.</p></details>
        <details id="draw-history-panel" class="draw-history" hidden ><summary>Historial de giros</summary><ol id="draw-history"></ol></details>
        </div></div><section class="wheel-prizes" aria-label="Premios del sorteo"><h3>Los premios</h3><PrizeGallery prizes={raffle.prizes}/></section>
      </aside>
    </div>
    {isAdmin && <RaffleTeam owner={isOwner}/>}
    <script id="raffle-data" type="application/json" is:inline set:html={JSON.stringify(raffle).replace(/</g,'\u003c')}></script>
  </main> : <main id="main-content" class="error-page"><div><span class="eyebrow">{unavailable ? 'NO PUDIMOS CONECTAR' : 'ESTE NÚMERO NO SALIÓ'}</span><h1>{unavailable ? 'La rifa no está disponible' : 'No encontramos esta rifa'}</h1><p>{unavailable ? 'La base de datos no respondió o sus reglas aún no permiten consultar la rifa. Intenta nuevamente en un momento.' : 'Revisa el enlace o vuelve al inicio para crear una nueva oportunidad.'}</p><a class="btn btn-primary" href="/">Volver al inicio <Icon name="arrow" size={16}/></a></div></main>}
  {isAdmin && <>
    <dialog id="sale-modal" aria-labelledby="sale-title"><div class="modal-header"><div><span class="eyebrow">REGISTRA AL COMPRADOR</span><h2 id="sale-title">Marcar boleto como ocupado</h2><p id="sale-number"></p></div><button class="btn-icon" data-close aria-label="Cerrar"><Icon name="close"/></button></div><form id="sale-form" class="modal-form"><label class="field"><span class="field-label">Nombre del comprador</span><input id="buyer-name" class="input" required maxlength="120" autocomplete="name" autofocus/></label><label class="field"><span class="field-label">Contacto <small>Opcional</small></span><input id="buyer-contact" class="input" maxlength="80" placeholder="Teléfono u otro dato de contacto" autocomplete="tel"/></label><label class="field"><span class="field-label">Vendedor <small>Opcional</small></span><input id="buyer-seller" class="input" maxlength="120"/></label><label id="release-field" class="creation-option" hidden><input id="release-ticket" type="checkbox"/><span>Volver a disponible (conservar el cambio en el historial)</span></label><p class="field-help">Confirma la compra con el comprador. Al guardar, este boleto quedará ocupado y participará en el sorteo.</p><p id="sale-error" class="form-error" role="alert" hidden></p><div class="modal-actions"><button class="btn btn-outline" type="button" data-close>Cancelar</button><button id="sale-submit" class="btn btn-primary" type="submit">Guardar boleto ocupado</button></div></form></dialog>
    <dialog id="draw-modal" aria-labelledby="draw-title">
      <div class="modal-header"><div><h2 id="draw-title">Configura el sorteo</h2><p>Un giro. Una oportunidad. Tú marcas el ritmo.</p></div><button class="btn-icon" data-close aria-label="Cerrar"><Icon name="close"/></button></div>
      <form id="draw-form" class="modal-form">
        <p class="confirm-copy">Siguen participando <strong id="eligible-count">{soldCount}</strong> boletos comprados.</p>
        <div class="draw-counts">
          <label id="winner-count-field" class="field"><span class="field-label">Ganadores</span><input id="winner-count" class="input" type="number" value={Math.max(1,Math.min(raffle!.prizes.length,soldCount))} min="1" max={Math.max(1,soldCount)} step="1" required/><span class="field-help">La cuenta baja hasta el ganador 1, que recibe el primer premio.</span></label>
          <label id="elimination-field" class="field"><span class="field-label">Giros de descarte</span><input id="elimination-count" class="input" type="number" value="0" min="0" max={Math.max(0, soldCount-1)} step="1" required/><span class="field-help">Cada giro descarta un boleto. Usa 0 para elegir solo ganadores.</span></label>
        </div>
        <fieldset id="draw-mode-field" class="draw-options"><legend class="field-label">Orden de los giros</legend><label class="draw-option"><input type="radio" name="draw-mode" value="sequential" checked/><span><strong>Descartes primero</strong><small>Después, un giro por cada ganador.</small></span></label><label class="draw-option"><input type="radio" name="draw-mode" value="mixed"/><span><strong>Intercalar ganadores y descartes</strong><small>Elige el tipo antes de cada giro.</small></span></label></fieldset>
        <fieldset id="draw-kind-field" class="draw-options" hidden><legend class="field-label">Este giro es para…</legend><div class="draw-kind-control"><label><input type="radio" name="draw-kind" value="winner" checked/><span><Icon name="gift" size={17}/>Elegir ganador</span></label><label><input type="radio" name="draw-kind" value="elimination"/><span><Icon name="close" size={17}/>Descartar boleto</span></label></div><p id="draw-remaining" class="field-help"></p></fieldset>
        <p id="draw-next-note" class="draw-next-note" aria-live="polite"></p>
        <p class="field-help">El tipo de giro se elige antes de conocer el número. Las cantidades y el modo se fijan al comenzar; las ventas se cierran con el primer giro.</p>
        <p id="draw-error" class="form-error" role="alert" hidden></p>
        <div class="modal-actions"><button class="btn btn-outline" type="button" data-close>Volver</button><button id="confirm-draw" type="submit" class="btn btn-primary">Iniciar sorteo</button></div>
      </form>
    </dialog>
    {isOwner && <DeleteRaffleDialog/>}
    <RaffleSettingsDialog/>
  </>}
  <script src="../../scripts/raffle.ts"></script>
</Layout>
