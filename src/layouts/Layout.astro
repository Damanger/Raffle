---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { Image, getImage } from 'astro:assets';
import squirrel from '../assets/squirrel.png';
interface Props { title?: string; description?: string; user?: App.Locals['user'] }
const { title = 'rifas-squirrel · Rifas con ruleta', description = 'Crea tu rifa, comparte tus boletos y deja que la ruleta elija al ganador.', user = null } = Astro.props;
const favicon = await getImage({ src: squirrel, width: 64, height: 64, fit: 'contain', format: 'png' });
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={favicon.src} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir al contenido</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="rifas-squirrel, inicio"><span class="brand-mark"><Image src={squirrel} alt="La ardilla de rifas-squirrel" width={72} height={54} fit="contain" format="webp" loading="eager"/></span><span>rifas-squirrel</span></a>
      <nav aria-label="Navegación principal">
        {user ? <><a class="nav-link" href="/perfil">Mis rifas</a><button id="logout" class="btn-icon" aria-label="Cerrar sesión" title="Cerrar sesión"><Icon name="logout"/></button></> : <><a class="nav-link" href="/#como-funciona">Cómo funciona</a><a class="nav-pill" href="/perfil">Crear una rifa <Icon name="plus" size={15}/></a></>}
      </nav>
    </header>
    <slot />
    <footer class="site-footer"><a href="/" class="footer-brand">rifas-squirrel</a><span>Hecho para reunir. Diseñado para emocionar.</span><a href="/perfil">Crea tu próxima rifa <Icon name="arrow" size={14}/></a></footer>
    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
    <script src="../scripts/auth.ts"></script>
    <script src="../scripts/animations.ts"></script>
  </body>
</html>
